# ── Microsoft Foundry CI/CD ────────────────────────────────────
# Evaluation result files (generated by pipeline — do not commit)
eval/results/*.json
eval/results/*.xml
# Keep .gitkeep and dataset files
!eval/results/.gitkeep
!eval/datasets/

# Foundry state (agent version IDs written by deploy scripts)
.foundry/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Azure CLI
.azure/

# Workflow files (managed manually; GitHub App lacks workflows:write scope)
.github/workflows/

# Playwright artifacts (v4.8.3)
playwright-report/
test-results/
playwright/.cache/


# Core dumps
core
core.*

# v5.5.1 GA preview server — esbuild bundle cache
.preview-cache/

