{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build && npm run build:server",
    "build:server": "node scripts/build-waste-anchor.mjs",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "deploy": "npm run build && wrangler pages deploy dist --project-name webapp",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:edge": "vitest run --project edge",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && echo 'No lint errors'",
    "analytics:provision": "bash scripts/provision-analytics.sh",
    "analytics:status": "npx wrangler r2 bucket list && npx wrangler pipelines list && npx wrangler pipelines sinks list && npx wrangler pipelines streams list",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright --ui",
    "test:e2e:smoke": "playwright test tests/e2e/easy-tenancy.spec.ts",
    "test:e2e:report": "playwright show-report",
    "build:tsup": "tsup",
    "build:rollup": "rollup -c rollup.config.mjs",
    "build:all": "npm run build && npm run build:tsup && npm run build:rollup"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "d3": "^7.9.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "xrpl": "^5.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0",
    "tsup": "^7.0.0",
    "rollup": "^3.30.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-commonjs": "^23.0.2",
    "@rollup/plugin-typescript": "^11.0.0",
    "rollup-plugin-terser": "^7.0.2"
  }
}
